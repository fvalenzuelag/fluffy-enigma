# GitHub Actions: Settings → Secrets and variables → Actions.
# Copia a .env solo para pruebas locales; no subas .env al repositorio.

# Credencial AWS
AWS_ACCESS_KEY_ID=
# Credencial AWS
AWS_SECRET_ACCESS_KEY=
# Token de sesión (STS / credenciales temporales; opcional si usas claves largas)
AWS_SESSION_TOKEN=

# Región (ej. us-east-1)
AWS_REGION=us-east-1

# URL base del registry ECR (para docker login)
ECR_REGISTRY=

# URL del repo en ECR (sin tag), una por servicio
ECR_REPO_URL_BACKEND=
ECR_REPO_URL_FRONTEND=
ECR_REPO_URL_DB=

# IDs de instancia EC2 (despliegue vía SSM u otro)
EC2_BACKEND_INSTANCE_ID=
EC2_FRONTEND_INSTANCE_ID=
EC2_DB_INSTANCE_ID=

# MySQL en EC2 (SSM levanta cartas-mysql + cartas-app; ver .github/workflows/cartas-backend.yml)
MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=
